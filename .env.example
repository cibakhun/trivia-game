# Kopie als .env anlegen und Werte lokal setzen. .env wird nie eingecheckt.
# Nur Namen und ungefährliche lokale Vorgaben; echte Secrets gehören in die Umgebung des Servers.

# local | test | staging | production
APP_ENV=local

# Lokale Datenbank aus docker-compose.yml. Wer POSTGRES_PORT ändert, muss den Port in
# DATABASE_URL und TEST_DATABASE_URL unten gleich setzen.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# DATABASE_URL=postgres://rdw:<POSTGRES_PASSWORD>@127.0.0.1:5432/rdw
DATABASE_URL=

# Integrationstests legen je Testdatei eine eigene Datenbank an und brauchen Superuser-Rechte
# auf einem Wegwerf-Server (z. B. dem lokalen Docker-Postgres). Nie Staging oder Produktion.
# TEST_DATABASE_URL=postgres://rdw:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
TEST_DATABASE_URL=

# Server (apps/server). Herkunft des Clients: zustandsändernde Anfragen müssen genau diesen
# Origin-Header tragen (ADR-028). COOKIE_SECURE=false nur lokal ohne https; in Staging und
# Produktion lehnt der Server das ab.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
LOG_LEVEL=info

# Partie mit Ausbau: Wissensfragen, die eine Kategorie für das Glücksrad braucht (MATCH_RULES
# §11.6). Ohne Angabe 20; lokal und in Tests 1, weil es je Kategorie nur wenige Testfragen gibt.
# Nur für eine Umgebung mit eigenem Fragenbestand setzen, etwa 10 für den ersten Spieltest. Mit
# den Testfragen startet bei einem Wert über 1 keine Partie mit Ausbau (NOT_ENOUGH_CATEGORIES).
# REALM_MIN_CATEGORY_QUESTIONS=10

# Geheimnis für den auditierbaren Zufall (ARCHITECTURE §9), mindestens 32 Byte, Base64.
# Erzeugen z. B. mit: openssl rand -base64 48
RNG_SECRET=
RNG_KEY_ID=1

# Mailversand (ADR-086): Bestätigungslinks für die E-Mail-Adresse. Vorgabe ist `outbox`: Jede Mail
# landet als Textdatei in mail-ausgang/ (von git ausgeschlossen), der Link steht auch im Log; es
# geht nichts hinaus und darum wird kein unbestätigtes Konto gelöscht. Mit `smtp` geht die Mail
# über einen SMTP-Zugang hinaus, und die Frist von 30 Tagen gilt. Zugangsdaten nur hier oder in
# der Umgebung, nie im Repository; sie erscheinen in keinem Log. In Produktion ist `smtp` Pflicht.
# MAIL_TRANSPORT=outbox
# MAIL_OUTBOX_DIR=
# Beispiel Gmail mit App-Passwort: smtps://konto%40gmail.com:<app-passwort>@smtp.gmail.com:465
# SMTP_URL=
# MAIL_FROM=Reiche des Wissens <konto@example.org>
