# Kopie als .env anlegen und Werte lokal setzen. .env wird nie eingecheckt.
# Nur Namen und ungefährliche lokale Vorgaben; echte Secrets gehören in die Umgebung des Servers.

# local | test | staging | production
APP_ENV=local

# Lokale Datenbank aus docker-compose.yml. Wer POSTGRES_PORT ändert, muss den Port in
# DATABASE_URL und TEST_DATABASE_URL unten gleich setzen.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# DATABASE_URL=postgres://rdw:<POSTGRES_PASSWORD>@127.0.0.1:5432/rdw
DATABASE_URL=

# Integrationstests legen je Testdatei eine eigene Datenbank an und brauchen Superuser-Rechte
# auf einem Wegwerf-Server (z. B. dem lokalen Docker-Postgres). Nie Staging oder Produktion.
# TEST_DATABASE_URL=postgres://rdw:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
TEST_DATABASE_URL=

# Server (apps/server). Herkunft des Clients: zustandsändernde Anfragen müssen genau diesen
# Origin-Header tragen (ADR-028). COOKIE_SECURE=false nur lokal ohne https; in Staging und
# Produktion lehnt der Server das ab.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
LOG_LEVEL=info

# Geheimnis für den auditierbaren Zufall (ARCHITECTURE §9), mindestens 32 Byte, Base64.
# Erzeugen z. B. mit: openssl rand -base64 48
RNG_SECRET=
RNG_KEY_ID=1
