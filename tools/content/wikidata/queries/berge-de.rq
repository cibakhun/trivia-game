# Berge in Deutschland mit Höhe über dem Meer (normalisiert in Metern), für deutsche Spieler.
SELECT ?item ?label ?sitelinks ?value WHERE {
  VALUES ?class { wd:Q8502 wd:Q8072 }
  ?item wdt:P31 ?class;
        wdt:P17 wd:Q183;
        wikibase:sitelinks ?sitelinks.
  FILTER(?sitelinks >= 12)
  ?item p:P2044 ?statement.
  ?statement a wikibase:BestRank;
             psn:P2044/wikibase:quantityAmount ?value.
  ?item rdfs:label ?label.
  FILTER(LANG(?label) = "de")
}
ORDER BY DESC(?sitelinks)
LIMIT 120
