# Bekannte Opern mit Komponist.
SELECT ?item ?label ?sitelinks ?answer ?answerLabel ?answerBirth WHERE {
  ?item wdt:P31 wd:Q1344;
        wikibase:sitelinks ?sitelinks.
  FILTER(?sitelinks >= 30)
  ?item wdt:P86 ?answer.
  OPTIONAL { ?answer wdt:P569 ?answerBirth }
  ?item rdfs:label ?label.
  FILTER(LANG(?label) = "de")
  ?answer rdfs:label ?answerLabel.
  FILTER(LANG(?answerLabel) = "de")
}
ORDER BY DESC(?sitelinks)
LIMIT 200
