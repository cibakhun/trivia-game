  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@node-rs/argon2": "2.2.2",
    "@rdw/db": "workspace:*",
    "@rdw/game-core": "workspace:*",
    "@rdw/protocol": "workspace:*",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rdw/content-tools": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
