{
  "name": "@rdw/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx --env-file-if-exists=../../.env src/main-api.ts",
